# Copy to .env for `npm start`. `npm run dev` needs none of these: it sets its own for the emulator.

# Your app's ID, from the developer portal's Credentials tab. app-config.json's appId must match it.
APP_ID=order-export
# Your app's secret, shown once in the developer portal. It never leaves the server.
APP_SECRET=
# Your install URL, exactly as registered in the developer portal.
REDIRECT_URI=https://order-export.example.com/auth/callback
# FlyCommerce's API, where install codes and store credentials are exchanged.
HUB_API_URL=https://developers.flycommerce.com/api
# 32 random bytes, base64, that seal store credentials on disk: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Where each store's credential is kept, sealed.
CREDENTIALS_FILE=data/credentials.json
# The port this server listens on.
PORT=4000
# Optional: dashboards allowed to frame your pages. Defaults to FlyCommerce's.
# FRAME_ANCESTORS=https://*.flycommerce.com https://*.flycom.shop
# Optional: where session tokens are verified. Defaults to FlyCommerce's; only the emulator changes them.
# JWKS_URL=https://app.flycommerce.com/.well-known/jwks.json
# ALLOWED_ISSUERS=https://app.flycommerce.com
