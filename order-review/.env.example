# Copy to .env for `npm start`. `npm run dev` needs none of this: it runs against the emulator.

# Your app's ID and secret, from the developer portal's Credentials tab. The secret never leaves the server.
APP_ID=order-review
APP_SECRET=
# FlyCommerce's API.
HUB_API_URL=https://developers.flycommerce.com/api
# Your install URL, exactly as registered in the developer portal.
REDIRECT_URI=http://localhost:4000/auth/callback
# The port this server listens on.
PORT=4000
# Optional. Dashboards allowed to frame your pages; defaults to FlyCommerce's.
# FRAME_ANCESTORS=https://*.flycommerce.com https://*.flycom.shop
